+# v1.x spelled three of these differently. Someone upgrading from 1.8.x has the right
+# directories already exported under the old names, and without this they get
+# "does not seem to be set :(" for a variable that is, in substance, set -- with nothing
+# to connect the message to the variable they are actually carrying. Honour the old name,
+# say so once, and point at the new one.
+LEGACY_ENV_VARIABLES = {
+    "NCBI_ASSEMBLY_DATA_DIR": "NCBI_assembly_data_dir",
+    "GTDB_DIR": "GTDB_dir",
+}
 
+
+def resolve_env_variable(variable):
+    """
+    (path, legacy_name_used_or_None) for a data-location variable.
+
+    Prefers the current name; falls back to the v1.x spelling when only that is set.
+    """
+    path = os.environ.get(variable, "")
+    if path:
+        return path, None
+
+    legacy = LEGACY_ENV_VARIABLES.get(variable)
+    if legacy:
+        legacy_path = os.environ.get(legacy, "")
+        if legacy_path:
+            return legacy_path, legacy
+
+    return "", None
+
+
