+
+# A bacterial or archaeal FASTA this small is very unlikely to be a draft genome, whatever
+# its extension says. The two real cases that motivated this: a 37 kb file holding a single
+# gene accession (LC054541) that had been saved under a species name, and a 685 kb
+# single-contig record that went on to recover 5 of 138 SCGs. Free-living bacterial genomes
+# start around 1 Mb and the smallest endosymbionts around 0.11 Mb, so 500 kb is well clear of
+# anything ordinary.
+#
+# This only ever WARNS. Viral genomes are routinely 5-200 kb and GToTree supports them, so a
+# hard exit here would reject a legitimate workflow outright. The point is to put the
+# information in front of the user in the first seconds of a run rather than at the end of it.
+SMALL_GENOME_BP = 500_000
+
+
+def summarize_fasta(path, cap_bp=SMALL_GENOME_BP):
+    """
+    (total_bp, num_seqs, looks_like_fasta) with an early exit once the file is clearly
+    big enough to be a genome. Reading stops at `cap_bp`, so this costs microseconds on a
+    normal input and only reads a small file in full.
+    """
+    total = num_seqs = 0
+    looks_like_fasta = False
+    try:
+        with open(path, "rb") as fh:
+            first = fh.readline()
+            looks_like_fasta = first.startswith(b">")
+            if looks_like_fasta:
+                num_seqs = 1
+            else:
+                return 0, 0, False
+            for line in fh:
+                if line.startswith(b">"):
+                    num_seqs += 1
+                else:
+                    total += len(line.strip())
+                    if total >= cap_bp:
+                        return total, num_seqs, True
+    except OSError:
+        return 0, 0, False
+    return total, num_seqs, looks_like_fasta
+
+
+def check_input_fasta_sanity(fasta_files):
+    """
+    Look inside the input FASTAs before the run starts.
+
+    `check_input_genome_files` already validates the input *list* up front, on the principle
+    in its own docstring: fail before any asset is downloaded or any taxon resolved. But
+    nothing opens the files themselves, so a record that cannot possibly be a genome is
+    accepted, has its genes called, and is searched against every profile in the SCG set
+    before being dropped at the hit-count filter. On a 138-marker set that is the entire
+    per-genome cost of the run, spent to learn something a single read establishes.
+
+    Two different severities, on purpose:
+
+      - a file that doesn't begin with '>' cannot be read as FASTA at all, so it exits;
+      - a file that is merely very small only warns, because viral genomes are legitimately
+        this size and GToTree supports them.
+
+    Deliberately narrow otherwise: it says nothing about assembly quality. Fragmented and
+    contaminated assemblies are real problems too, but their thresholds are taxon-dependent
+    and belong to the user's judgement rather than to a blanket check.
+    """
+    not_fasta, small = [], []
+
+    for path in fasta_files:
+        if not os.path.isfile(path):
+            continue  # existence is already reported by check_inputs_exist()
+        total_bp, num_seqs, looks_like_fasta = summarize_fasta(path)
+        name = os.path.basename(path)
+        if not looks_like_fasta:
+            not_fasta.append(name)
+        elif total_bp < SMALL_GENOME_BP:
+            small.append(f"{name} ({total_bp:,} bp in {num_seqs} sequence(s))")
+
+    if not_fasta:
+        report_message(
+            "These input files don't start with a '>' header, so they can't be read as "
+            f"FASTA:\n\n{bullet_list(not_fasta)}\n", "red")
+        print()
+        report_very_early_exit()
+
+    if small:
+        report_notice(
+            "These inputs are smaller than a typical bacterial or archaeal genome. That is "
+            "expected for viruses, but for anything else it usually means a gene or "
+            "amino-acid record was saved under a genome's name -- and such a file will have "
+            "its genes called and be searched against every profile in the SCG set before "
+            "being dropped at the hit-count filter. Flagging it here so the run isn't spent "
+            "finding out. If you meant to supply amino acids, `-A` is the flag for that."
+            f"\n\n{bullet_list(small)}\n")
+        print()
 
 
