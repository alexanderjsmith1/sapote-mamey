  "_meta": {
    "schema_version": "domain_role_taxonomy/1.0",
    "description": "Controlled mapping from antiSMASH/PFAM/TIGRFAM domain-name substrings to biosynthetic role categories, for domain-level Mode B (v9.7.89). Matching is case-insensitive substring on the domain name. Categories are ordered: the first category whose any pattern matches wins. Unmatched biosynthetic-looking domains fall to 'Other accessory/domain'; DUF/repeat fall to 'Unknown/repeat/accessory'.",
    "claim_safety_note": "Role assignment is structural (what the domain IS), never a product/identity claim."
  },
