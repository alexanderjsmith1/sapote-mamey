  "short_labels": [
    ["PepM", "PepM"], ["Ppd", "Ppd"], ["aminotransferase", "AT"], ["PLP", "PLP"],
    ["AurF", "AurF"], ["aldehyde", "Aldedh"], ["NRPS", "NRPS"], ["PKS", "PKS"],
    ["RiPP", "RiPP"], ["halogenase", "Hal"], ["methyltransferase", "MT"]
  ],
  "palette": [
