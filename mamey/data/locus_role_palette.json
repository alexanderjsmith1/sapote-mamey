    {"regex": "Aldedh", "role": "aldehyde dehydrogenase (tailoring)", "color": "#16A085", "is_core": false},
    {"regex": "Condensation|AMP-binding|PP-binding|Epimerization|Thioesterase|NRPS", "role": "NRPS module", "color": "#34495E", "is_core": true},
    {"regex": "PKS_KS|PKS_AT|PKS_KR|PKS_DH|PKS_ER|Ketoacyl|trans-AT|PKS", "role": "PKS module", "color": "#2C3E50", "is_core": true},
    {"regex": "YcaO|Lant|LanB|LanC|RiPP|precursor|protease", "role": "RiPP machinery", "color": "#9B59B6", "is_core": true},
    {"regex": "Methyltransf|rSAM|radical.?SAM|\\bB12\\b", "role": "methyltransferase (tailoring)", "color": "#7D3C98", "is_core": false},
