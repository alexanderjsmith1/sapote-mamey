{
  "_meta": {
    "schema_version": "locus_role_palette/1.0",
    "description": "Ordered gene-role palette for deterministic locus maps (v9.7.90). Each entry: {regex, role, color, is_core}. The regex is matched (case-insensitive) against the antiSMASH gene_functions + sec_met_domain + note blob for a CDS; first hit wins. Unknown genes fall to the default 'other / hypothetical'. is_core controls whether the gene gets a bold short-label on the arrow.",
    "claim_safety_note": "Roles are antiSMASH rule/smCOG annotations, not BLASTP-confirmed identities. Capacity-level, never a product claim."
  },
