{
  "contract_id": "modeb_evidence_streams_v1",
  "contract_version": "1.0.0",
  "claim_ceiling": "Availability and provenance do not establish biological identity, production, activity, novelty, causality, or phenotype; missing or unbound evidence is not biological absence.",
  "binding_precedence": [
    "EXACT_LOCUS",
    "ALIAS_BOUND",
    "STRAIN_ONLY",
    "UNBOUND",
    "ABSENT"
  ],
  "streams": [
    {
      "id": "inventory_identity",
      "label": "Canonical inventory identity",
      "scope": "exact_locus",
      "required_for_authoring": true,
      "patterns": ["(?:^|[/_])(?:inventory|triage_board|per_bgc_index)(?:[/_.-]|$)"],
      "sections": ["1", "2", "3", "18", "19", "20", "28", "30"]
    },
    {
      "id": "antismash_region",
      "label": "antiSMASH region source",
      "scope": "exact_locus",
      "required_for_authoring": false,
      "patterns": ["region\\d+\\.gbk$"],
      "sections": ["1", "2", "3", "4", "5", "7", "9", "10", "12", "13", "17"]
    },
    {
      "id": "gene_inventory",
      "label": "Per-gene inventory/context",
      "scope": "exact_or_alias",
      "required_for_authoring": true,
      "patterns": ["gene_context", "gene_by_gene", "per_gene", "cds_inventory"],
      "sections": ["3", "4", "5", "7", "9", "10", "12", "13", "17", "28"]
    },
    {
      "id": "kcb_mibig",
      "label": "KnownClusterBlast or MIBiG comparison",
      "scope": "exact_or_alias",
      "required_for_authoring": false,
      "patterns": ["knowncluster", "mibig", "kcb"],
      "sections": ["2", "8", "11", "14", "19", "24", "28"]
    },
    {
      "id": "clusterblast",
      "label": "ClusterBlast comparison",
      "scope": "exact_or_alias",
      "required_for_authoring": false,
      "patterns": ["clusterblast", "cluster_blast"],
      "sections": ["8", "11", "14", "19", "28"]
    },
    {
      "id": "blastp_per_gene",
      "label": "Exact-current per-gene BLASTp",
      "scope": "exact_or_alias",
      "required_for_authoring": false,
      "patterns": ["blastp", "top_hit_per_gene", "top10_blastp"],
      "sections": ["4", "8", "11", "14", "16", "19", "28"]
    },
    {
      "id": "domains_hmm",
      "label": "Domain or HMM evidence",
      "scope": "exact_or_alias",
      "required_for_authoring": false,
      "patterns": ["domain", "hmmer", "hmm", "pfam", "tigrfam"],
      "sections": ["3", "4", "5", "9", "10", "12", "13", "17", "21", "22", "23", "25", "26", "27", "29"]
    },
    {
      "id": "selected_gene",
      "label": "Selected-gene evidence",
      "scope": "exact_or_alias",
      "required_for_authoring": false,
      "patterns": ["selected_gene", "priority_protein", "candidate_gene", "core_gene"],
      "sections": ["4", "9", "10", "16", "17", "28", "30"]
    },
    {
      "id": "bigscape_gcf",
      "label": "BiG-SCAPE or GCF context",
      "scope": "exact_or_alias",
      "required_for_authoring": false,
      "patterns": ["bigscape", "gcf"],
      "sections": ["8", "11", "14", "19", "24", "28"]
    },
    {
      "id": "resistance",
      "label": "Resistance/self-protection evidence",
      "scope": "exact_or_alias",
      "required_for_authoring": false,
      "patterns": ["resistance", "self_protection", "self-protection"],
      "sections": ["7", "15", "19", "28", "30"]
    },
    {
      "id": "locus_map",
      "label": "Locus map",
      "scope": "exact_or_alias",
      "required_for_authoring": false,
      "patterns": ["locus_map.*\\.(?:png|svg)$", "_locus\\.(?:png|svg)$"],
      "sections": ["1", "3", "4", "17", "28"]
    },
    {
      "id": "locus_map_data",
      "label": "Locus-map companion data",
      "scope": "exact_or_alias",
      "required_for_authoring": false,
      "patterns": ["locus_(?:map_)?data\\.(?:csv|tsv)$", "locus_map_manifest"],
      "sections": ["3", "4", "17", "28"]
    },
    {
      "id": "literature_context",
      "label": "Literature context",
      "scope": "class_or_strain",
      "required_for_authoring": false,
      "patterns": ["literature", "reference_family", "citation"],
      "sections": ["2", "6", "8", "11", "14", "19", "28"]
    },
    {
      "id": "thesis_context",
      "label": "Thesis/cohort context",
      "scope": "class_or_strain",
      "required_for_authoring": false,
      "patterns": ["thesis", "pollinator", "attine", "moss", "bryophyte"],
      "sections": ["6", "8", "11", "14", "28"]
    },
    {
      "id": "strain_phenotype",
      "label": "Strain-level phenotype/activity context",
      "scope": "strain_only",
      "required_for_authoring": false,
      "patterns": ["phenotype", "bioactivity", "antifungal", "antibacterial", "assay"],
      "sections": ["6", "15", "19", "28", "30"]
    },
    {
      "id": "prior_modeb_card",
      "label": "Prior Mode B card or draft",
      "scope": "exact_or_alias",
      "required_for_authoring": false,
      "patterns": ["mode[_ -]?b.*\\.md$", "modeb.*\\.md$"],
      "sections": ["28"]
    },
    {
      "id": "qa_receipt",
      "label": "QA/provenance receipt",
      "scope": "exact_or_alias",
      "required_for_authoring": false,
      "patterns": ["qa_receipt", "validation_receipt", "source_manifest", "manifest_sha256", "verify_modeb"],
      "sections": ["20", "28"]
    }
  ]
}
